+def test_inner_failure_class_survives_caller_no_progress(caplog):
+    """D1 (F1 audit): a caller's coarse class must not erase the structural one.
+
+    Production shape (five records, 2026-09-18): the compressor stamps the real diagnosis
+    ('empty_post_handoff_window') in its telemetry, the caller then emits the attempt with
+    failure_class='no_progress'. Before this fix the emitted line said only 'no_progress', and
+    the structural cause had to be reverse-engineered from an unrelated field. Both classes are
+    now readable in the same line; the structural one stays authoritative.
+    """
+    compressor = SimpleNamespace(
+        _last_compression_telemetry={
+            "failure_class": "empty_post_handoff_window",
+            "window_start": 1, "window_end": 2, "middle_window_pre_scan_tokens": 37,
+        },
+        _last_summary_fallback_used=False,
+        _last_aux_model_failure_model=None,
+    )
+    agent = SimpleNamespace(
+        context_compressor=compressor, session_id="session-d1", _compression_attempt_id="attempt-d1",
+    )
+
+    with caplog.at_level(logging.INFO):
+        _emit_compression_attempt_telemetry(
+            agent, started_at=time.monotonic(), commit_status="aborted", split_status="aborted",
+            failure_class="no_progress",
+        )
+
+    payload = _extract_telemetry(caplog)
+    assert payload["failure_class"] == "empty_post_handoff_window"
+    assert payload["attempt_failure_class"] == "no_progress"
+    # F2 fields ride along on the same line, so one log entry answers "which window, how full".
+    assert payload["window_start"] == 1
+    assert payload["window_end"] == 2
+    assert payload["middle_window_pre_scan_tokens"] == 37
+
+
+def test_caller_class_applies_when_none_was_stamped(caplog):
+    """No inner class → the caller's class is the only diagnosis and must be kept as-is."""
+    compressor = SimpleNamespace(
+        _last_compression_telemetry={},
+        _last_summary_fallback_used=False,
+        _last_aux_model_failure_model=None,
+    )
+    agent = SimpleNamespace(
+        context_compressor=compressor, session_id="session-d1b", _compression_attempt_id="attempt-d1b",
+    )
+
+    with caplog.at_level(logging.INFO):
+        _emit_compression_attempt_telemetry(
+            agent, started_at=time.monotonic(), commit_status="aborted", split_status="aborted",
+            failure_class="no_progress",
+        )
+
+    payload = _extract_telemetry(caplog)
+    assert payload["failure_class"] == "no_progress"
+    assert "attempt_failure_class" not in payload
