+class TestF1FeasibilityFastPaths:
+    """F1: one OBJECTIVE pre-LLM fast-path, then the unchanged heuristic gate.
+
+    A skip means the LLM summarization call is NOT made and the deterministic
+    message dropping proceeds. Each test asserts BOTH the verdict and the stamped
+    reason — a skip that fires for the wrong reason is a silent regression.
+    """
+
+    def _compressor(self):
+        from agent.context_compressor import ContextCompressor
+        c = ContextCompressor(model="test/model", quiet_mode=True,
+                              protect_first_n=2, protect_last_n=2)
+        c.threshold_tokens = 80_000
+        c._ineffective_compression_count = 0
+        c._prellm_skip_count = 0
+        return c
+
+    # --- removed fast-path A: an empty middle is NOT a skip ---------------- 
+    def test_empty_middle_does_not_skip(self):
+        """REGRESSION (F1 audit): an empty middle must NOT be a fast-path. Production proves the
+        state is reachable ONLY through the structural no-op exits (4657/4680 cold, 4680 hot),
+        both of which return BEFORE _feasibility_skip — so a skip here was dead code, and in the
+        unreachable state it would silently replace the safe no-op with summary dropping."""
+        c = self._compressor()
+        telemetry = {"middle_window_tokens": 0, "post_deterministic_tokens": 84_000}
+        assert c._feasibility_skip(telemetry, [], 2, 9, 84_000) is False
+        assert telemetry.get("feasibility_skip_reason") is None
+        assert c._prellm_skip_count == 0
+
+    # --- fast-path B: deterministic passes already reclaimed enough --------
+    def test_reclaim_sufficient_skips_llm(self):
+        c = self._compressor()
+        telemetry = {"middle_window_tokens": 30_000, "post_deterministic_tokens": 50_000,
+                     "deterministic_reclaim_estimate": 25_000}
+        assert c._feasibility_skip(telemetry, [], 2, 9, 95_000) is True
+        assert telemetry["feasibility_skip_reason"] == "reclaim_sufficient"
+
+    def test_reclaim_zero_does_not_skip_even_under_threshold(self):
+        """Guard: a synthetic/high current_tokens with nothing actually dropped must still call the
+        LLM — otherwise the 401/abort-preserve-session path is silently disabled."""
+        c = self._compressor()
+        telemetry = {"middle_window_tokens": 30_000, "post_deterministic_tokens": 1_000,
+                     "deterministic_reclaim_estimate": 0}
+        assert c._feasibility_skip(telemetry, [], 2, 9, 999_999) is False
+        assert telemetry.get("feasibility_skip_reason") is None
+
+    def test_reclaim_insufficient_runs_the_llm(self):
+        c = self._compressor()
+        telemetry = {"middle_window_tokens": 30_000, "post_deterministic_tokens": 92_000,
+                     "deterministic_reclaim_estimate": 3_000}
+        assert c._feasibility_skip(telemetry, [], 2, 9, 95_000) is False
+        assert telemetry.get("feasibility_skip_reason") is None
+        assert c._prellm_skip_count == 0
+
+    # --- unchanged semantics: no pressure, no strike → normal LLM path -----
+    def test_no_trigger_pressure_keeps_old_behaviour(self):
+        """current_tokens unknown (not an over-threshold trigger) → fast-path B must NOT fire."""
+        c = self._compressor()
+        telemetry = {"middle_window_tokens": 30_000, "post_deterministic_tokens": 10_000}
+        assert c._feasibility_skip(telemetry, [], 2, 9, None) is False
+
+    def test_large_middle_no_strike_runs_the_llm(self):
+        """Normal LLM compression path: a big middle with no strike is never skipped."""
+        c = self._compressor()
+        telemetry = {"middle_window_tokens": 40_000, "post_deterministic_tokens": 95_000}
+        assert c._feasibility_skip(telemetry, [], 2, 9, 95_000) is False
+
+    def test_heuristic_gate_still_skips_small_middle_with_strike(self):
+        """The pre-existing #60451 gate is preserved verbatim."""
+        c = self._compressor()
+        c._ineffective_compression_count = 1
+        telemetry = {"middle_window_tokens": 5_000, "post_deterministic_tokens": 95_000}
+        assert c._feasibility_skip(telemetry, [], 2, 9, 95_000) is True
+        assert telemetry["feasibility_skip_reason"] == "small_middle"
